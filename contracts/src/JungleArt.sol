    function _body(uint256 color) private pure returns (string memory) {
        if (color == 1) return "#e9e854";
        if (color == 2) return "#ed3534";
        if (color == 3) return "#395fa2";
        if (color == 4) return "#ed5c80";
        if (color == 5) return "#000000";
        if (color == 6) return "#fefefe";
        return "";
    }

    function _edge(uint256 color) private pure returns (string memory) {
        if (color == 1) return "#040402";
        if (color == 2) return "#040202";
        if (color == 3) return "#020203";
        if (color == 4) return "#040303";
        if (color == 5) return "#000000";
        if (color == 6) return "#040404";
        return "";
    }
